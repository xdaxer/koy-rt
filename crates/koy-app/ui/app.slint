import { Theme } from "theme.slint";
export { Theme }

export component Probe inherits Window {
    no-frame: true;
    background: transparent;
    always-on-top: true;
    width: 200px;
    height: 36px;
    Rectangle {
        background: Theme.notch-surface;
        border-radius: 18px;
        Text { text: "Koy"; color: Theme.notch-text; font-family: Theme.notch-font; }
    }
}
