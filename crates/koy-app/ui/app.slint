import { Theme } from "theme.slint";
import { Icons, KoyIcon } from "icons.slint";
import { Motion, ToggleSwitch, KoyButton, ButtonKind, Segmented, KoyComboBox, KoyTextBox, SettingRow, SettingText, NavItem, KoyLogo, WindowsLogo, KoyStartIcon, LinkButton, InfoNotice, KeyBadge, ColorSwatch, KoyCheckBox } from "controls.slint";
import { NotchInput, NotchSwitch, NotchRowButton, NotchPillButton, NotchPlainButton, NotchPassword } from "notch_controls.slint";
import { SagAltMenuWindow, MenuText } from "menu.slint";
import { WeatherGlyph } from "status.slint";
import { SystemPanel, SystemStatsData, SystemText } from "system_panel.slint";
import { CalendarPanel, CalendarData, CalendarText, CalCellData, CalWeekRowData, CalEventData } from "calendar_panel.slint";
import { ClipboardPanel, ClipFilterData, ClipCardData, ClipText } from "clipboard_panel.slint";
import { ShelfPanel, ShelfItemData, ShelfText } from "shelf_panel.slint";
import { FocusPanel, FocusData, TasksData, FocusText, FocusTabData, FocusPresetData, FocusLapData, TaskRowData } from "focus_panel.slint";
export { Theme, Motion, SagAltMenuWindow, MenuText, SystemText, SystemStatsData, FocusText, FocusData, TasksData, FocusTabData, FocusPresetData, FocusLapData, TaskRowData, ShelfItemData, ShelfText, ClipFilterData, ClipCardData, ClipText, CalendarData, CalendarText, CalCellData, CalWeekRowData, CalEventData }

// Bileşen denetimi: kontrol kitaplığının derlendiğini ve çizildiğini doğrulayan önizleme penceresi.
export component Probe inherits Window {
    no-frame: true;
    background: transparent;
    always-on-top: true;
    width: 420px;
    height: 320px;
    Rectangle {
        background: Theme.bg-window;
        border-radius: 12px;
        VerticalLayout {
            padding: 12px;
            spacing: 8px;
            SettingRow { SettingText { title: "Koy"; description: "Bileşen önizleme"; } ToggleSwitch { checked: true; } }
            HorizontalLayout { spacing: 8px; KoyButton { text: "Standart"; } KoyButton { text: "Birincil"; kind: ButtonKind.primary; } KoyButton { text: "Sil"; kind: ButtonKind.danger; } }
            Segmented { items: ["Koyu", "Açık", "Sistem"]; selected: 0; }
            KoyComboBox { items: ["Bir", "İki"]; selected: 0; }
            KoyTextBox { placeholder: "Ara"; }
            HorizontalLayout { spacing: 8px; KoyLogo { width: 24px; height: 24px; } WindowsLogo { width: 20px; height: 20px; } KoyStartIcon { width: 20px; height: 20px; } KeyBadge { text: "Ctrl"; } ColorSwatch { swatch: #3b82f6; checked: true; } KoyCheckBox { checked: true; } }
            NavItem { icon: Icons.settings; text: "Genel"; checked: true; }
            LinkButton { text: "Daha fazla"; }
        }
    }
}

// Geliştirici önizlemesi: çentik panellerini koyu çentik yüzeyinde çizer (`koy --snapshot <panel> <png>`).
export component NotchPanelPreview inherits Window {
    in property <string> panel;
    in property <SystemStatsData> sys;
    in property <FocusData> fdata;
    in property <TasksData> tasks;
    in property <[ShelfItemData]> shelf-items;
    in property <string> shelf-count;
    in property <[ClipFilterData]> clip-filters;
    in property <[ClipCardData]> clip-items;
    in property <CalendarData> cal;
    width: 640px;
    height: 230px;
    background: Theme.notch-surface;
    VerticalLayout {
        padding: 16px;
        if panel == "system": SystemPanel { data: sys; }
        if panel == "calendar": CalendarPanel { data: cal; }
        if panel == "clipboard": ClipboardPanel { filters: clip-filters; items: clip-items; }
        if panel == "shelf": ShelfPanel { items: shelf-items; count-text: shelf-count; }
        if panel == "focus": FocusPanel { fdata: fdata; tasks: tasks; }
    }
}
