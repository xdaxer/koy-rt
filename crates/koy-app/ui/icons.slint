// WPF KoyIcon karşılığı: 24x24 birimlik çizgi simgesi; renk `color`, boyut 16 (varsayılan) ya da 20, çizgi 24 birimde 2.
export component KoyIcon inherits Path {
    in property <string> data;
    in property <length> size: 16px;
    in property <color> color: gray;
    in property <float> stroke-units: 2;
    width: size;
    height: size;
    commands: data;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: color;
    stroke-width: stroke-units * size / 24;
    stroke-line-cap: round;
    stroke-line-join: round;
}
