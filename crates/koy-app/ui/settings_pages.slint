// Karşılığı: PerformansPage.xaml
export component PerformancePage inherits VerticalLayout {
    spacing: 6px;
    in property <float> memory-pct;
    in property <int> memory-level;
    SettingRow {
        filtered-out: S.changed-only;
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 8px;
            HorizontalLayout {
                SettingText { title: Tr.t("MemoryUsageTitle"); description: Tr.t("BudgetDesc"); }
                Text {
                    text: S.text("MemoryUsageText");
                    color: Theme.text-primary;
                    font-size: Theme.font-row-title;
                    font-family: Theme.font;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                height: 6px;
                border-radius: 3px;
                background: Theme.toggle-track-off;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.memory-pct / 100, 0, 1);
                    border-radius: 3px;
                    background: root.memory-level == 2 ? Theme.danger-text : root.memory-level == 1 ? Theme.status-warn : Theme.status-ok;
                }
            }
        }
    }
    SectionHeader { text: Tr.t("BatteryHeader"); }
    BoolRow { key: "Appearance.BatterySaverReduceMotion"; title: Tr.t("BatteryReduceMotion"); description: ""; }
    SectionHeader { text: Tr.t("DataHeader"); }
    ComboRow { key: "Weather.RefreshInterval"; title: Tr.t("WeatherRefreshTitle"); description: ""; values: ["Every30Minutes", "Hourly", "OnStartup"]; labels: [Tr.t("Interval30m"), Tr.t("Interval1h"), Tr.t("IntervalStartupOnly")]; }
    InfoNotice { text: Tr.t("IdleNotice"); }
}

