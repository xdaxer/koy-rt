// Karşılığı: SubPages/CentikBehaviorSubPage.xaml
export component NotchBehaviorPage inherits VerticalLayout {
    spacing: 6px;
    SectionHeader { text: Tr.t("NotchHeader"); }
    SegRow { key: "Notch.Visibility"; title: Tr.t("VisibilityTitle"); description: Tr.t("VisibilityDesc"); values: ["Fixed", "Smart", "Peek"]; labels: [Tr.t("VisFixed"), Tr.t("VisSmart"), Tr.t("VisPeek")]; }
    SegRow { key: "Notch.Style"; title: Tr.t("NotchStyleTitle"); description: ""; values: ["Pinned", "Floating"]; labels: [Tr.t("NotchStylePinned"), Tr.t("NotchStyleFloating")]; }
    BoolRow { key: "Notch.EdgeLine"; title: Tr.t("NotchEdgeLineTitle"); description: Tr.t("NotchEdgeLineDesc"); }
    SegRow { key: "Notch.EdgeLineColor"; title: Tr.t("NotchEdgeLineColorTitle"); description: ""; values: ["NotchSurface", "Accent"]; labels: [Tr.t("NotchEdgeLineColorNotch"), Tr.t("NotchEdgeLineColorAccent")]; enabled: S.on("Notch.EdgeLine"); }
    TextRow { key: "Notch.EdgeLineThickness"; title: Tr.t("NotchEdgeLineThicknessTitle"); description: Tr.t("NotchEdgeLineThicknessDesc"); box-width: 64px; enabled: S.on("Notch.EdgeLine"); }
    BoolRow { key: "Notch.HideInFullscreen"; title: Tr.t("HideInFullscreenTitle"); description: ""; }
    SectionHeader { text: Tr.t("OpenBehaviorTitle"); }
    SegRow { key: "Notch.OpenBehavior"; title: Tr.t("OpenBehaviorRowTitle"); description: ""; values: ["Hover", "Click", "DragOver"]; labels: [Tr.t("OpenOnHover"), Tr.t("OpenOnClick"), Tr.t("OpenOnDragOver")]; }
    SectionHeader { text: Tr.t("IdleDisplayTitle"); }
    SegRow { key: "Notch.IdleDisplay"; title: Tr.t("IdleDisplayRowTitle"); description: ""; values: ["ClockAndBattery", "ClockOnly", "RingClockDay", "Nothing"]; labels: [Tr.t("IdleClockBattery"), Tr.t("IdleClockOnly"), Tr.t("IdleRingClockDay"), Tr.t("IdleNone")]; }
    SectionHeader { text: Tr.t("IndicatorsHeader"); }
    BoolRow { key: "Notch.ShowVolumeOsd"; title: Tr.t("VolumeOsdTitle"); description: ""; }
    BoolRow { key: "Notch.ShowBrightnessOsd"; title: Tr.t("BrightnessOsdTitle"); description: ""; }
    BoolRow { key: "Notch.ShowPrivacyIndicator"; title: Tr.t("PrivacyIndicatorTitle"); description: ""; }
    BoolRow { key: "Notch.ShowNotifications"; title: Tr.t("NotificationsTitle"); description: Tr.t("NotificationsDesc"); }
    if S.flag("NotificationsPermissionMissing"): SettingDesc { text: Tr.t("NotificationsNeedPermission"); color: Theme.danger-text; }
    SectionHeader { text: Tr.t("NavAdvanced"); }
    ListRow { key: "Notch.OpenDelayMs"; title: Tr.t("NotchOpenDelayTitle"); description: ""; list: "NotchDelayOptions"; suffix: "ms"; }
    ListRow { key: "Notch.CloseDelayMs"; title: Tr.t("NotchCloseDelayTitle"); description: ""; list: "NotchDelayOptions"; suffix: "ms"; }
    BoolRow { key: "Notch.NotificationsHideBody"; title: Tr.t("NotificationsHideBodyTitle"); description: ""; }
}

// Karşılığı: SubPages/CentikVisualsSubPage.xaml
