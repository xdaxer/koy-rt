// Karşılığı: SubPages/GorunumThemeSubPage.xaml
export component AppearanceThemePage inherits VerticalLayout {
    spacing: 6px;
    SectionHeader { text: Tr.t("ThemeHeader"); }
    SegRow { key: "Appearance.Theme"; title: Tr.t("ThemeTitle"); description: ""; values: ["System", "Dark", "Light"]; labels: [Tr.t("ThemeSystem"), Tr.t("ThemeDark"), Tr.t("ThemeLight")]; }
    SettingRow {
        changed: S.is-changed("Appearance.AccentColor");
        filtered-out: S.changed-only && !self.changed;
        highlighted: S.highlight != "" && S.highlight == Tr.t("AccentColorTitle");
        opacity: S.on("Appearance.UseWindowsAccent") ? 0.5 : 1;
        SettingText { title: Tr.t("AccentColorTitle"); }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            for sw in [
                { hex: "#3B82F6", c: #3B82F6, name: Tr.t("AccentBlue") },
                { hex: "#8B5CF6", c: #8B5CF6, name: Tr.t("AccentPurple") },
                { hex: "#EC4899", c: #EC4899, name: Tr.t("AccentPink") },
                { hex: "#F97316", c: #F97316, name: Tr.t("AccentOrange") },
                { hex: "#22C55E", c: #22C55E, name: Tr.t("AccentGreen") },
                { hex: "#14B8A6", c: #14B8A6, name: Tr.t("AccentTeal") },
            ]: VerticalLayout {
                alignment: center;
                ColorSwatch {
                    swatch: sw.c;
                    label: sw.name;
                    checked: S.get("Appearance.AccentColor") == sw.hex;
                    clicked => {
                        if (!S.on("Appearance.UseWindowsAccent")) {
                            S.set("Appearance.AccentColor", sw.hex);
                        }
                    }
                }
            }
        }
    }
    BoolRow { key: "Appearance.UseWindowsAccent"; title: Tr.t("UseWindowsAccentTitle"); description: ""; }
    SectionHeader { text: Tr.t("SurfaceHeader"); }
    SegRow { key: "Appearance.Material"; title: Tr.t("MaterialTitle"); description: ""; values: ["Solid", "Frosted", "Glass"]; labels: [Tr.t("MaterialSolid"), Tr.t("MaterialFrosted"), Tr.t("MaterialGlass")]; }
    SegRow { key: "Appearance.CornerRadius"; title: Tr.t("CornerRadiusTitle"); description: ""; values: ["6", "12", "18"]; labels: [Tr.t("CornerSharp"), Tr.t("CornerStandard"), Tr.t("CornerRound")]; }
    BoolRow { key: "Notch.FollowsMaterial"; title: Tr.t("NotchFollowsMaterialTitle"); description: Tr.t("NotchFollowsMaterialDesc"); }
    BoolRow { key: "Appearance.MaterialReadabilityGuard"; title: Tr.t("ReadabilityGuardTitle"); description: ""; }
}

