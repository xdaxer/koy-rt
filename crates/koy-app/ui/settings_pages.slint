// ---------------------------------------------------------------- Kısayollar

export struct ShortcutRowData {
    title: string,
    tokens: [string],
    capturing: bool,
    error: string,
    is-default: bool,
    has-shortcut: bool,
}

export global SC {
    in property <[ShortcutRowData]> rows;
    callback start-capture(int);
    callback cancel-capture(int);
    callback reset(int);
    // Yakalama kutusuna gelen tuş: metin ve Ctrl, Alt, Shift, Win. true: işlendi.
    callback key(int, string, bool, bool, bool, bool) -> bool;
}

// Kısayol satırı: başlık ve hata; sağda yakalama kutusu (rozetler) ve "varsayılan" düğmesi.
component ShortcutRowView inherits SettingRow {
    in property <ShortcutRowData> sc-row;
    in property <int> index;
    filtered-out: S.changed-only && sc-row.is-default;
    changed: !sc-row.is-default;
    VerticalLayout {
        alignment: center;
        horizontal-stretch: 1;
        SettingTitle { text: root.sc-row.title; }
        if root.sc-row.error != "": SettingDesc { text: root.sc-row.error; color: Theme.status-warn; }
    }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle {
                min-width: 170px;
                height: 32px;
                border-radius: Theme.radius-control;
                background: Theme.bg-control;
                border-width: root.sc-row.capturing ? 2px : 1px;
                border-color: root.sc-row.capturing ? Theme.accent : (ta.has-hover ? Theme.border-strong : Theme.border-control);
                HorizontalLayout {
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 4px;
                    alignment: center;
                    if root.sc-row.capturing: Text { text: Tr.t("ShortcutPressKeys"); color: Theme.accent-text; vertical-alignment: center; font-size: Theme.font-control; }
                    if !root.sc-row.capturing && !root.sc-row.has-shortcut: Text { text: Tr.t("ShortcutNone"); color: Theme.text-muted; vertical-alignment: center; font-size: Theme.font-control; }
                    if !root.sc-row.capturing: HorizontalLayout {
                        spacing: 4px;
                        for t in root.sc-row.tokens: VerticalLayout {
                            alignment: center;
                            KeyBadge { text: t; }
                        }
                    }
                }
                ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        fs.focus();
                        SC.start-capture(root.index);
                    }
                }
                fs := FocusScope {
                    key-pressed(e) => {
                        if (root.sc-row.capturing) {
                            if (SC.key(root.index, e.text, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta)) {
                                return accept;
                            }
                        }
                        reject
                    }
                    focus-changed-event => {
                        if (!self.has-focus && root.sc-row.capturing) {
                            SC.cancel-capture(root.index);
                        }
                    }
                }
            }
        }
        if !root.sc-row.is-default: VerticalLayout {
            alignment: center;
            KoyButton { text: Tr.t("ShortcutReset"); clicked => { SC.reset(root.index); } }
        }
    }
}

// Karşılığı: KisayollarPage.xaml
export component ShortcutsPage inherits VerticalLayout {
    spacing: 6px;
    SectionHeader { text: Tr.t("KeyboardHeader"); filtered-out: S.changed-only; }
    for r[i] in SC.rows: ShortcutRowView { sc-row: r; index: i; }
    if !S.changed-only: InfoNotice { text: Tr.t("ShortcutsNotice"); }
    SectionHeader { text: Tr.t("MouseHeader"); }
    SegRow { key: "Notch.WheelAction"; title: Tr.t("WheelActionTitle"); description: ""; values: ["SwitchPanel", "Volume"]; labels: [Tr.t("WheelSwitchPanel"), Tr.t("WheelVolume")]; }
    SegRow { key: "Dock.MiddleClickAction"; title: Tr.t("MiddleClickTitle"); description: ""; values: ["NewWindow", "Close"]; labels: [Tr.t("MidClickNewWindow"), Tr.t("MidClickClose")]; }
    SectionHeader { text: Tr.t("CornersHeader"); }
    if !S.changed-only: PageSubtitle { text: Tr.t("CornersHint"); }
    ComboRow { key: "HotCorners.TopLeft"; title: Tr.t("CornerTopLeft"); description: ""; combo-width: 200px; values: ["None", "OpenNotch", "OpenSearch", "OpenKoyWindow", "ToggleDock"]; labels: [Tr.t("CornerActionNone"), Tr.t("CornerActionOpenNotch"), Tr.t("CornerActionOpenSearch"), Tr.t("CornerActionOpenKoyWindow"), Tr.t("CornerActionToggleDock")]; }
    ComboRow { key: "HotCorners.TopRight"; title: Tr.t("CornerTopRight"); description: ""; combo-width: 200px; values: ["None", "OpenNotch", "OpenSearch", "OpenKoyWindow", "ToggleDock"]; labels: [Tr.t("CornerActionNone"), Tr.t("CornerActionOpenNotch"), Tr.t("CornerActionOpenSearch"), Tr.t("CornerActionOpenKoyWindow"), Tr.t("CornerActionToggleDock")]; }
    ComboRow { key: "HotCorners.BottomLeft"; title: Tr.t("CornerBottomLeft"); description: ""; combo-width: 200px; values: ["None", "OpenNotch", "OpenSearch", "OpenKoyWindow", "ToggleDock"]; labels: [Tr.t("CornerActionNone"), Tr.t("CornerActionOpenNotch"), Tr.t("CornerActionOpenSearch"), Tr.t("CornerActionOpenKoyWindow"), Tr.t("CornerActionToggleDock")]; }
    ComboRow { key: "HotCorners.BottomRight"; title: Tr.t("CornerBottomRight"); description: ""; combo-width: 200px; values: ["None", "OpenNotch", "OpenSearch", "OpenKoyWindow", "ToggleDock"]; labels: [Tr.t("CornerActionNone"), Tr.t("CornerActionOpenNotch"), Tr.t("CornerActionOpenSearch"), Tr.t("CornerActionOpenKoyWindow"), Tr.t("CornerActionToggleDock")]; }
    ComboRow { key: "HotCorners.DwellMs"; title: Tr.t("CornerDwellTitle"); description: ""; combo-width: 200px; values: ["200", "400", "700", "1000"]; labels: ["200 ms", "400 ms", "700 ms", "1000 ms"]; }
    BoolRow { key: "HotCorners.DisableInFullscreen"; title: Tr.t("CornerFullscreenTitle"); description: ""; }
}

// ---------------------------------------------------------------- Ekranlar

export struct MonitorCardData {
    number: int,
    left: length,
    top: length,
    width: length,
    height: length,
    selected: bool,
    primary: bool,
    notch: bool,
    dock: bool,
}

export global DP {
    in property <[MonitorCardData]> cards;
    in property <length> schema-width;
    in property <length> schema-height;
    in property <bool> has-selection;
    in property <string> header;
    in property <string> name;
    in property <string> details;
    in property <bool> primary;
    in property <bool> notch-on;
    in property <bool> dock-on;
    // 0: çentik ve dock, 1: yalnız çentik, 2: hiçbiri
    in property <int> new-screen;
    callback identify();
    callback select(int);
    callback notch-toggled(bool);
    callback dock-toggled(bool);
    callback new-screen-changed(int);
}

component MonitorCardView inherits Rectangle {
    in property <MonitorCardData> card;
    callback clicked;
    border-radius: 8px;
    background: card.selected ? Theme.accent-subtle : Theme.bg-control;
    border-width: card.selected ? 2px : 1px;
    border-color: card.selected ? Theme.accent : (ta.has-hover ? Theme.border-strong : Theme.border-control);
    if card.notch: Rectangle {
        y: 6px;
        width: 40px;
        height: 7px;
        border-radius: 3.5px;
        background: Theme.text-primary;
    }
    Text {
        text: card.number;
        font-size: min(root.height * 0.38, 34px);
        font-weight: 600;
        color: card.selected ? Theme.accent-text : Theme.text-primary;
    }
    if card.dock: Rectangle {
        y: parent.height - 14px;
        width: min(64px, parent.width - 16px);
        height: 8px;
        border-radius: 4px;
        background: Theme.text-secondary;
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

// Karşılığı: EkranlarPage.xaml
export component DisplaysPage inherits VerticalLayout {
    spacing: 6px;
    HorizontalLayout {
        alignment: start;
        KoyButton { text: Tr.t("DisplaysIdentify"); clicked => { DP.identify(); } }
    }
    Rectangle {
        height: 180px;
        background: Theme.bg-row;
        border-width: 1px;
        border-color: Theme.border-hairline;
        border-radius: Theme.radius-row;
        Rectangle {
            width: DP.schema-width;
            height: DP.schema-height;
            for c[i] in DP.cards: MonitorCardView {
                x: c.left;
                y: c.top;
                width: c.width;
                height: c.height;
                card: c;
                clicked => {
                    DP.select(i);
                }
            }
        }
    }
    if DP.has-selection: VerticalLayout {
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            padding-top: 16px;
            SectionHeader { text: DP.header; }
            if DP.primary: VerticalLayout {
                alignment: center;
                Rectangle {
                    border-radius: 4px;
                    background: Theme.accent-subtle;
                    HorizontalLayout {
                        padding-left: 6px;
                        padding-right: 6px;
                        padding-top: 1px;
                        padding-bottom: 1px;
                        Text { text: Tr.t("DisplayPrimaryBadge"); color: Theme.accent-text; font-size: Theme.font-caption; }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
        }
        SettingRow {
            SettingText { title: DP.name; description: DP.details; }
        }
        SettingRow {
            SettingText { title: Tr.t("ScreenNotchTitle"); }
            VerticalLayout {
                alignment: center;
                ToggleSwitch { checked: DP.notch-on; toggled(v) => { DP.notch-toggled(v); } }
            }
        }
        SettingRow {
            SettingText { title: Tr.t("ScreenDockTitle"); }
            VerticalLayout {
                alignment: center;
                ToggleSwitch { checked: DP.dock-on; toggled(v) => { DP.dock-toggled(v); } }
            }
        }
    }
    SectionHeader { text: Tr.t("NewDisplaysHeader"); }
    SettingRow {
        SettingText { title: Tr.t("NewDisplayActionTitle"); }
        VerticalLayout {
            alignment: center;
            Segmented {
                items: [Tr.t("NewDisplayBoth"), Tr.t("NewDisplayNotchOnly"), Tr.t("NewDisplayNone")];
                selected: DP.new-screen;
                changed(i) => {
                    DP.new-screen-changed(i);
                }
            }
        }
    }
    InfoNotice { text: Tr.t("MultiMonitorNotice"); }
}

// Karşılığı: IdentifyOverlayWindow.cs — ekranı tanımlama numarası (2 sn, tıklama geçirir).
export component IdentifyOverlayWindow inherits Window {
    in property <int> number;
    no-frame: true;
    always-on-top: true;
    background: Theme.bg-window;
    width: 180px;
    height: 180px;
    Rectangle {
        border-radius: 28px;
        border-width: 1px;
        border-color: Theme.border-strong;
        Text {
            text: root.number;
            font-size: 110px;
            font-weight: 700;
            color: Theme.text-primary;
        }
    }
}

// ---------------------------------------------------------------- Profiller ve kurallar

export struct ProfileItemData {
    name: string,
    sections: string,
    renaming: bool,
    edit-name: string,
    delete-confirming: bool,
}

export struct SectionOptionData {
    label: string,
    selected: bool,
}

export global PR {
    in property <[ProfileItemData]> items;
    in property <[SectionOptionData]> sections;
    in-out property <string> new-name;
    in property <string> status;
    in property <bool> status-error;
    in property <bool> has-pending;
    in property <string> pending-name;
    in property <string> pending-sections;
    in property <string> pending-changes;
    callback new-name-edited(string);
    callback section-toggled(int, bool);
    // Eylem adları: SaveCurrent, ExportCurrent, Import, ConfirmImportSave, ConfirmImportApply, CancelImport
    callback command(string);
    // Satır eylemleri: Apply, Export, Duplicate, BeginRename, CommitRename, CancelRename, RequestDelete, CancelDelete, ConfirmDelete
    callback item-command(int, string);
    callback edit-name-edited(int, string);
}

component ProfileRow inherits SettingRow {
    in property <ProfileItemData> item;
    in property <int> index;
    filtered-out: S.changed-only;
    if !item.renaming && !item.delete-confirming: SettingText { title: root.item.name; description: root.item.sections; }
    if !item.renaming && !item.delete-confirming: HorizontalLayout {
        alignment: end;
        spacing: 6px;
        VerticalLayout { alignment: center; KoyButton { text: Tr.t("ProfilesApply"); kind: ButtonKind.primary; clicked => { PR.item-command(root.index, "Apply"); } } }
        VerticalLayout { alignment: center; KoyButton { text: Tr.t("ProfilesRename"); clicked => { PR.item-command(root.index, "BeginRename"); } } }
        VerticalLayout { alignment: center; KoyButton { text: Tr.t("ProfilesDuplicate"); clicked => { PR.item-command(root.index, "Duplicate"); } } }
        VerticalLayout { alignment: center; KoyButton { text: Tr.t("ProfilesExport"); clicked => { PR.item-command(root.index, "Export"); } } }
        VerticalLayout { alignment: center; KoyButton { text: Tr.t("ProfilesDelete"); kind: ButtonKind.danger; clicked => { PR.item-command(root.index, "RequestDelete"); } } }
    }
    if item.renaming: HorizontalLayout {
        spacing: 6px;
        horizontal-stretch: 1;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            KoyTextBox {
                text: root.item.edit-name;
                edited(t) => { PR.edit-name-edited(root.index, t); }
                accepted(t) => { PR.item-command(root.index, "CommitRename"); }
            }
        }
        VerticalLayout { alignment: center; KoyButton { text: Tr.t("Cancel"); clicked => { PR.item-command(root.index, "CancelRename"); } } }
        VerticalLayout { alignment: center; KoyButton { text: Tr.t("ProfilesRenameConfirm"); kind: ButtonKind.primary; clicked => { PR.item-command(root.index, "CommitRename"); } } }
    }
    if item.delete-confirming: SettingText { title: root.item.name; }
    if item.delete-confirming: HorizontalLayout {
        alignment: end;
        spacing: 6px;
        VerticalLayout { alignment: center; KoyButton { text: Tr.t("Cancel"); clicked => { PR.item-command(root.index, "CancelDelete"); } } }
        VerticalLayout { alignment: center; KoyButton { text: Tr.t("ProfilesDeleteConfirm"); kind: ButtonKind.danger; clicked => { PR.item-command(root.index, "ConfirmDelete"); } } }
    }
}

// Karşılığı: SubPages/GenelProfilesSubPage.xaml
export component GeneralProfilesPage inherits VerticalLayout {
    spacing: 6px;
    SectionHeader { text: Tr.t("ProfilesHeader"); filtered-out: S.changed-only; }
    SettingRow {
        filtered-out: S.changed-only;
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            SettingTitle { text: Tr.t("ProfilesSaveTitle"); }
            KoyTextBox {
                text: PR.new-name;
                edited(t) => { PR.new-name-edited(t); }
                accepted(t) => { PR.command("SaveCurrent"); }
            }
            HorizontalLayout {
                spacing: 12px;
                alignment: start;
                for o[i] in PR.sections: KoyCheckBox {
                    text: o.label;
                    checked: o.selected;
                    toggled(v) => { PR.section-toggled(i, v); }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                KoyButton { text: Tr.t("ProfilesSaveButton"); kind: ButtonKind.primary; clicked => { PR.command("SaveCurrent"); } }
                KoyButton { text: Tr.t("ProfilesExportCurrentButton"); clicked => { PR.command("ExportCurrent"); } }
                KoyButton { text: Tr.t("ProfilesImportButton"); clicked => { PR.command("Import"); } }
            }
            if PR.status != "": SettingDesc { text: PR.status; color: PR.status-error ? Theme.danger-text : Theme.text-secondary; }
        }
    }
    if PR.has-pending: SettingRow {
        highlighted: true;
        VerticalLayout {
            spacing: 6px;
            horizontal-stretch: 1;
            SettingTitle { text: Tr.t("ProfilesImportPreviewTitle"); font-weight: 600; }
            SettingTitle { text: PR.pending-name; }
            SettingDesc { text: PR.pending-sections; }
            SettingDesc { text: PR.pending-changes; }
            SettingDesc { text: Tr.t("ProfilesImportMachineNote"); }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                KoyButton { text: Tr.t("ProfilesImportSave"); clicked => { PR.command("ConfirmImportSave"); } }
                KoyButton { text: Tr.t("ProfilesImportApply"); kind: ButtonKind.primary; clicked => { PR.command("ConfirmImportApply"); } }
                KoyButton { text: Tr.t("Cancel"); clicked => { PR.command("CancelImport"); } }
            }
        }
    }
    if PR.items.length == 0 && !S.changed-only: SettingDesc { text: Tr.t("ProfilesEmpty"); }
    for it[i] in PR.items: ProfileRow { item: it; index: i; }
    if !S.changed-only: HorizontalLayout {
        alignment: start;
        padding-left: 2px;
        LinkButton { text: Tr.t("ExtGetMore"); clicked => { S.action("OpenStoreCommand:Profile"); } }
    }
}

export struct RuleItemData {
    title: string,
    profile: string,
    enabled: bool,
}

export global RU {
    in property <[RuleItemData]> items;
    in property <[string]> running-apps;
    in property <[string]> profile-options;
    in property <int> selected-profile;
    in property <string> process-text;
    in property <string> status;
    in property <bool> status-error;
    callback process-edited(string);
    callback pick-app(int);
    callback select-profile(int);
    callback refresh-running();
    callback add();
    callback toggled(int, bool);
    callback delete(int);
}

// Karşılığı: SubPages/GenelRulesSubPage.xaml
export component GeneralRulesPage inherits VerticalLayout {
    spacing: 6px;
    SectionHeader { text: Tr.t("RulesHeader"); filtered-out: S.changed-only; }
    SettingRow {
        filtered-out: S.changed-only;
        VerticalLayout {
            spacing: 8px;
            horizontal-stretch: 1;
            SettingTitle { text: Tr.t("RulesAddTitle"); }
            HorizontalLayout {
                spacing: 8px;
                KoyTextBox {
                    horizontal-stretch: 1;
                    text: RU.process-text;
                    placeholder: "chrome";
                    edited(t) => { RU.process-edited(t); }
                    accepted(t) => { RU.add(); }
                }
                KoyComboBox {
                    width: 180px;
                    items: RU.running-apps;
                    selected: -1;
                    changed(i) => { RU.pick-app(i); }
                }
                KoyButton { text: Tr.t("RulesRefreshRunning"); clicked => { RU.refresh-running(); } }
            }
            SettingDesc { text: Tr.t("RulesProfileLabel"); }
            HorizontalLayout {
                spacing: 8px;
                KoyComboBox {
                    horizontal-stretch: 1;
                    items: RU.profile-options;
                    selected: RU.selected-profile;
                    changed(i) => { RU.select-profile(i); }
                }
                KoyButton { text: Tr.t("RulesAddButton"); kind: ButtonKind.primary; enabled: RU.profile-options.length > 0; clicked => { RU.add(); } }
            }
            if RU.status != "": SettingDesc { text: RU.status; color: RU.status-error ? Theme.danger-text : Theme.text-secondary; }
        }
    }
    if RU.items.length == 0 && !S.changed-only: SettingDesc { text: Tr.t("RulesEmpty"); }
    for r[i] in RU.items: SettingRow {
        filtered-out: S.changed-only;
        SettingText { title: r.title; description: r.profile; }
        HorizontalLayout {
            alignment: end;
            spacing: 10px;
            VerticalLayout {
                alignment: center;
                ToggleSwitch { checked: r.enabled; toggled(v) => { RU.toggled(i, v); } }
            }
            VerticalLayout {
                alignment: center;
                KoyButton { text: Tr.t("ProfilesDelete"); kind: ButtonKind.danger; clicked => { RU.delete(i); } }
            }
        }
    }
}

// ---------------------------------------------------------------- Gelişmiş

// kind: 0 bool, 1 tamsayı, 2 sayı, 3 metin, 4 seçim (AdvancedSettingKind sırası)
export struct AdvancedRowData {
    header: bool,
    key: string,
    title: string,
    kind: int,
    value: string,
    default-text: string,
    choices: [string],
    choice-index: int,
    changed: bool,
    error: string,
}

export global AD {
    in property <[AdvancedRowData]> rows;
    in property <string> filter;
    callback filter-edited(string);
    callback apply(string, string);
    callback reset(string);
}

component AdvancedRowView inherits Rectangle {
    in property <AdvancedRowData> ad-row;
    min-height: ad-row.header ? 36px : 56px;
    if ad-row.header: HorizontalLayout {
        padding-top: 14px;
        SectionHeader { text: root.ad-row.title; }
    }
    if !ad-row.header: SettingRow {
        changed: root.ad-row.changed;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            SettingTitle { text: root.ad-row.title; }
            Text { text: root.ad-row.key; color: Theme.text-muted; font-size: Theme.font-caption; font-family: Theme.font-mono; }
            SettingDesc { text: root.ad-row.default-text; }
            if root.ad-row.error != "": SettingDesc { text: root.ad-row.error; color: Theme.danger-text; }
        }
        HorizontalLayout {
            alignment: end;
            spacing: 8px;
            if root.ad-row.kind == 0: VerticalLayout {
                alignment: center;
                ToggleSwitch { checked: root.ad-row.value == "true"; toggled(v) => { AD.apply(root.ad-row.key, v ? "true" : "false"); } }
            }
            if root.ad-row.kind == 4: VerticalLayout {
                alignment: center;
                KoyComboBox {
                    width: 180px;
                    items: root.ad-row.choices;
                    selected: root.ad-row.choice-index;
                    changed(i) => { AD.apply(root.ad-row.key, root.ad-row.choices[i]); }
                }
            }
            if root.ad-row.kind >= 1 && root.ad-row.kind <= 3: VerticalLayout {
                alignment: center;
                box := KoyTextBox {
                    width: 180px;
                    text: root.ad-row.value;
                    accepted(t) => { AD.apply(root.ad-row.key, t); }
                }
            }
            if root.ad-row.changed: VerticalLayout {
                alignment: center;
                KoyButton { text: Tr.t("AdvancedResetRow"); clicked => { AD.reset(root.ad-row.key); } }
            }
        }
    }
}

// Karşılığı: GelismisPage.xaml
export component AdvancedPage inherits VerticalLayout {
    spacing: 6px;
    InfoNotice { text: Tr.t("AdvancedWarning"); }
    KoyTextBox {
        text: AD.filter;
        placeholder: Tr.t("AdvancedFilterPlaceholder");
        edited(t) => { AD.filter-edited(t); }
    }
    if AD.rows.length == 0: SettingDesc { text: Tr.t("SettingsSearchNoResult"); }
    for r in AD.rows: AdvancedRowView { ad-row: r; }
}

// ---------------------------------------------------------------- Eklentiler

export struct StoreCardData {
    id: string,
    name: string,
    meta: string,
    kind-label: string,
    summary: string,
    description: string,
    details: string,
    has-homepage: bool,
    busy: bool,
    show-install: bool,
    show-update: bool,
    show-apply: bool,
    applied: bool,
    show-uninstall: bool,
    apply-label: string,
    progress: float,
    uninstall-confirming: bool,
    expanded: bool,
    message: string,
    message-error: bool,
    has-preview: bool,
    preview: image,
}

export struct BuiltinCardData {
    id: string,
    name: string,
    kind-label: string,
    c1: color,
    c2: color,
    applied: bool,
}

export struct ConfirmFactData {
    label: string,
    value: string,
}

export global EX {
    in property <[StoreCardData]> cards;
    in property <[BuiltinCardData]> builtin;
    in property <string> search;
    in property <int> category;
    in property <int> filter;
    in property <int> sort;
    in property <bool> loading;
    in property <string> index-error;
    in property <string> status;
    in property <bool> status-error;
    in property <string> updates-label;
    in property <string> count-text;
    in property <string> show-more-text;
    in property <bool> has-more;
    in property <bool> empty;
    in property <bool> can-install-file;
    in property <bool> confirming;
    in property <string> confirm-title;
    in property <string> confirm-button;
    in property <string> confirm-note;
    in property <[ConfirmFactData]> confirm-facts;
    callback search-edited(string);
    callback category-changed(int);
    callback filter-changed(int);
    callback sort-changed(int);
    // RefreshIndex, InstallFromFile, ShowMore, ConfirmInstall, CancelConfirm
    callback command(string);
    // Install, Update, Apply, Disable, RequestUninstall, CancelUninstall, ConfirmUninstall, ToggleExpanded, OpenHomepage
    callback card-command(string, string);
    // Apply, Disable
    callback builtin-command(string, string);
}

component StoreCardView inherits Rectangle {
    in property <StoreCardData> card;
    background: Theme.bg-row;
    border-width: 1px;
    border-color: card.applied ? Theme.accent : Theme.border-hairline;
    border-radius: Theme.radius-row;
    height: lay.preferred-height;
    lay := VerticalLayout {
        padding: 12px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            Rectangle {
                width: 96px;
                height: 64px;
                border-radius: Theme.radius-small;
                background: Theme.bg-control;
                clip: true;
                if root.card.has-preview: Image { width: parent.width; height: parent.height; source: root.card.preview; image-fit: cover; }
                if !root.card.has-preview: Text { text: root.card.kind-label; color: Theme.text-muted; font-size: Theme.font-caption; }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 2px;
                HorizontalLayout {
                    spacing: 6px;
                    SettingTitle { text: root.card.name; font-weight: 600; horizontal-stretch: 0; }
                    if root.card.applied: VerticalLayout {
                        alignment: center;
                        Rectangle {
                            border-radius: 4px;
                            background: Theme.accent-subtle;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                Text { text: Tr.t("ExtApplied"); color: Theme.accent-text; font-size: Theme.font-caption; }
                            }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                SettingDesc { text: root.card.kind-label + (root.card.meta == "" ? "" : " · " + root.card.meta); }
                if root.card.summary != "": SettingDesc { text: root.card.summary; }
                if root.card.message != "": SettingDesc { text: root.card.message; color: root.card.message-error ? Theme.danger-text : Theme.status-ok; }
            }
        }
        if root.card.busy: Rectangle {
            height: 4px;
            border-radius: 2px;
            background: Theme.toggle-track-off;
            Rectangle { x: 0; width: parent.width * clamp(root.card.progress, 0, 1); border-radius: 2px; background: Theme.accent; }
        }
        HorizontalLayout {
            spacing: 6px;
            alignment: start;
            if root.card.show-update: KoyButton { text: Tr.t("ExtUpdate"); kind: ButtonKind.primary; clicked => { EX.card-command(root.card.id, "Update"); } }
            if root.card.show-install: KoyButton { text: Tr.t("ExtInstall"); kind: ButtonKind.primary; clicked => { EX.card-command(root.card.id, "Install"); } }
            if root.card.show-apply: KoyButton { text: root.card.apply-label; clicked => { EX.card-command(root.card.id, "Apply"); } }
            if root.card.applied: KoyButton { text: Tr.t("ExtDisable"); clicked => { EX.card-command(root.card.id, "Disable"); } }
            if root.card.show-uninstall && !root.card.uninstall-confirming: KoyButton { text: Tr.t("ExtUninstall"); kind: ButtonKind.danger; clicked => { EX.card-command(root.card.id, "RequestUninstall"); } }
            if root.card.show-uninstall && root.card.uninstall-confirming: SettingDesc { text: Tr.t("ExtUninstallConfirmQuestion"); vertical-alignment: center; }
            if root.card.show-uninstall && root.card.uninstall-confirming: KoyButton { text: Tr.t("ExtUninstall"); kind: ButtonKind.danger; clicked => { EX.card-command(root.card.id, "ConfirmUninstall"); } }
            if root.card.show-uninstall && root.card.uninstall-confirming: KoyButton { text: Tr.t("Cancel"); clicked => { EX.card-command(root.card.id, "CancelUninstall"); } }
            Rectangle { horizontal-stretch: 1; }
            LinkButton { text: Tr.t("ExtDetails"); clicked => { EX.card-command(root.card.id, "ToggleExpanded"); } }
        }
        if root.card.expanded: VerticalLayout {
            spacing: 4px;
            if root.card.description != "": SettingDesc { text: root.card.description; }
            SettingDesc { text: root.card.details; }
            if root.card.has-homepage: HorizontalLayout {
                alignment: start;
                LinkButton { text: Tr.t("ExtOpenHomepage"); clicked => { EX.card-command(root.card.id, "OpenHomepage"); } }
            }
        }
    }
}

component BuiltinCardView inherits Rectangle {
    in property <BuiltinCardData> card;
    width: 150px;
    height: 150px;
    background: Theme.bg-row;
    border-width: 1px;
    border-color: card.applied ? Theme.accent : Theme.border-hairline;
    border-radius: Theme.radius-row;
    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        Rectangle {
            height: 64px;
            border-radius: Theme.radius-small;
            background: @linear-gradient(135deg, root.card.c1 0%, root.card.c2 100%);
        }
        Text { text: root.card.name; color: Theme.text-primary; font-size: Theme.font-control; font-weight: 600; overflow: elide; }
        Text { text: root.card.kind-label; color: Theme.text-muted; font-size: Theme.font-caption; overflow: elide; }
        if !root.card.applied: KoyButton { text: Tr.t("ExtApply"); clicked => { EX.builtin-command(root.card.id, "Apply"); } }
        if root.card.applied: KoyButton { text: Tr.t("ExtDisable"); clicked => { EX.builtin-command(root.card.id, "Disable"); } }
    }
}

// Karşılığı: EklentilerPage.xaml
export component ExtensionsPage inherits VerticalLayout {
    spacing: 6px;
    SectionHeader { text: Tr.t("ExtFromFileHeader"); }
    SettingRow {
        SettingText { title: Tr.t("ExtFromFileTitle"); description: Tr.t("ExtFromFileDesc"); }
        VerticalLayout {
            alignment: center;
            KoyButton { text: Tr.t("ExtFromFileButton"); enabled: EX.can-install-file; clicked => { EX.command("InstallFromFile"); } }
        }
    }
    if EX.status != "": SettingDesc { text: EX.status; color: EX.status-error ? Theme.danger-text : Theme.text-secondary; }
    SectionHeader { text: Tr.t("ExtStoreHeader"); }
    HorizontalLayout {
        spacing: 8px;
        KoyTextBox {
            horizontal-stretch: 1;
            text: EX.search;
            placeholder: Tr.t("ExtSearchPlaceholder");
            edited(t) => { EX.search-edited(t); }
        }
        KoyButton { text: Tr.t("ExtRefresh"); clicked => { EX.command("RefreshIndex"); } }
    }
    HorizontalLayout {
        alignment: start;
        Segmented {
            items: [Tr.t("ExtCategoryAll"), Tr.t("ExtCategoryTheme"), Tr.t("ExtCategoryIconPack"), Tr.t("ExtCategoryBackground"), Tr.t("ExtCategoryProfile")];
            selected: EX.category;
            changed(i) => { EX.category-changed(i); }
        }
    }
    HorizontalLayout {
        spacing: 10px;
        Segmented {
            items: [Tr.t("ExtFilterAll"), Tr.t("ExtFilterInstalled"), EX.updates-label];
            selected: EX.filter;
            changed(i) => { EX.filter-changed(i); }
        }
        Rectangle { horizontal-stretch: 1; }
        SettingDesc { text: Tr.t("ExtSortLabel"); vertical-alignment: center; }
        KoyComboBox {
            width: 160px;
            items: [Tr.t("ExtSortNewest"), Tr.t("ExtSortAlphabetical"), Tr.t("ExtSortMostDownloads")];
            selected: EX.sort;
            changed(i) => { EX.sort-changed(i); }
        }
    }
    if EX.count-text != "": SettingDesc { text: EX.count-text; }
    if EX.index-error != "": InfoNotice { text: EX.index-error; }
    if EX.loading: SettingDesc { text: Tr.t("ExtLoading"); }
    if EX.empty: SettingDesc { text: Tr.t("ExtEmpty"); }
    if EX.builtin.length > 0: SectionHeader { text: Tr.t("LiveBgBuiltinHeader"); }
    if EX.builtin.length > 0: HorizontalLayout {
        spacing: 8px;
        alignment: start;
        for b in EX.builtin: BuiltinCardView { card: b; }
    }
    for c in EX.cards: StoreCardView { card: c; }
    if EX.has-more: HorizontalLayout {
        alignment: center;
        KoyButton { text: EX.show-more-text; clicked => { EX.command("ShowMore"); } }
    }
}

// Kurulum onayı (KoyWindow.xaml ConfirmOverlay).
export component ExtensionConfirmOverlay inherits Rectangle {
    background: Theme.scrim;
    TouchArea { }
    Rectangle {
        width: 420px;
        height: card.preferred-height;
        background: Theme.bg-row;
        border-width: 1px;
        border-color: Theme.border-strong;
        border-radius: Theme.radius-row;
        card := VerticalLayout {
            padding: 20px;
            spacing: 8px;
            Text { text: EX.confirm-title; font-size: Theme.font-page-title; font-weight: 600; color: Theme.text-primary; wrap: word-wrap; }
            for f in EX.confirm-facts: HorizontalLayout {
                spacing: 12px;
                Text { width: 130px; text: f.label; color: Theme.text-secondary; font-size: Theme.font-control; }
                Text { text: f.value; color: Theme.text-primary; font-size: Theme.font-control; wrap: word-wrap; horizontal-stretch: 1; }
            }
            if EX.confirm-note != "": SettingDesc { text: EX.confirm-note; }
            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                KoyButton { text: Tr.t("Cancel"); clicked => { EX.command("CancelConfirm"); } }
                KoyButton { text: EX.confirm-button; kind: ButtonKind.primary; clicked => { EX.command("ConfirmInstall"); } }
            }
        }
    }
}
