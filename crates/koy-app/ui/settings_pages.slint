// Koy penceresi ayar sayfaları. Karşılıkları: koy/src/App/Features/Settings/Pages/*.xaml ve SubPages/*.xaml.
// Satırlar XAML'dan çevirme betiğiyle çıkarıldı, karmaşık satırlar elle yazıldı. Arama dizini (settings_index.rs) bu
// dosyadan üretilir: sayfa bileşeni → (sayfa, alt sekme), SectionHeader → bölüm, satır başlığı/açıklaması/anahtarı.

import { Theme } from "theme.slint";
import { SectionHeader, PageTitle, PageSubtitle, SettingRow, SettingText, SettingTitle, SettingDesc, InfoNotice,
    ToggleSwitch, KoyButton, ButtonKind, ColorSwatch, LinkButton, KoyTextBox, Segmented, KoyLogo, KeyBadge, KoyCheckBox, KoyComboBox } from "controls.slint";
import { Icons, KoyIcon } from "icons.slint";
import { Tr, S, BoolRow, SegRow, SegStackRow, ComboRow, ListRow, SliderRow, TextRow, ButtonRow, RowButton } from "settings_kit.slint";

export struct ToggleItem {
    title: string,
    on: bool,
}

export struct OrderItem {
    title: string,
    on: bool,
    can-up: bool,
    can-down: bool,
}

// Görünüm modelindeki listeler (tepsi uygulamaları, arama kaynakları, ana sayfa kartları, sekme sırası).
export global SL {
    in property <[ToggleItem]> tray-apps;
    in property <[ToggleItem]> search-sources;
    in property <[OrderItem]> home-cards;
    in property <[OrderItem]> tab-order;
    callback tray-app-toggled(int, bool);
    callback search-source-toggled(int, bool);
    callback home-card-toggled(int, bool);
    callback home-card-move(int, int);
    callback tab-move(int, int);
}

component ToggleListRow inherits SettingRow {
    in property <string> title;
    in property <bool> on;
    callback toggled(bool);
    filtered-out: S.changed-only;
    SettingText { title: root.title; }
    VerticalLayout {
        alignment: center;
        sw := ToggleSwitch {
            checked: root.on;
            toggled(v) => {
                root.toggled(v);
            }
        }
    }
    changed on => {
        sw.checked = self.on;
    }
}

component MoveButton inherits Rectangle {
    in property <string> glyph;
    in property <bool> enabled: true;
    callback clicked;
    width: 28px;
    height: 28px;
    border-radius: Theme.radius-small;
    background: ta.has-hover && enabled ? Theme.bg-hover : transparent;
    opacity: enabled ? 1 : 0.35;
    KoyIcon { data: root.glyph; size: 14px; color: Theme.text-secondary; }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => {
            root.clicked();
        }
    }
}

component OrderRow inherits SettingRow {
    in property <string> title;
    in property <bool> on;
    in property <bool> show-toggle;
    in property <bool> can-up;
    in property <bool> can-down;
    callback toggled(bool);
    callback move(int);
    filtered-out: S.changed-only;
    SettingText { title: root.title; }
    HorizontalLayout {
        alignment: end;
        spacing: 4px;
        VerticalLayout {
            alignment: center;
            MoveButton { glyph: Icons.chevron-up; enabled: root.can-up; clicked => { root.move(-1); } }
        }
        VerticalLayout {
            alignment: center;
            MoveButton { glyph: Icons.chevron-down; enabled: root.can-down; clicked => { root.move(1); } }
        }
        if root.show-toggle: VerticalLayout {
            alignment: center;
            padding-left: 8px;
            ToggleSwitch {
                checked: root.on;
                toggled(v) => {
                    root.toggled(v);
                }
            }
        }
    }
}

// Renk kaynağı satırı (gösterge / rozet): vurgu, nötr, özel; özelde onaltılık kutu.
component ColorSourceRow inherits SettingRow {
    in property <string> key;
    in property <string> custom-key;
    in property <string> title;
    changed: S.is-changed(key) || S.is-changed(custom-key);
    filtered-out: S.changed-only && !self.changed;
    highlighted: S.highlight != "" && S.highlight == title;
    property <[string]> values: ["Accent", "Neutral", "Custom"];
    property <int> model-index: S.index(root.key, root.values);
    changed model-index => {
        seg.selected = self.model-index;
    }
    SettingText { title: root.title; }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        if root.model-index == 2: VerticalLayout {
            alignment: center;
            KoyTextBox {
                width: 96px;
                text: S.get(root.custom-key);
                placeholder: "#RRGGBB";
                edited(t) => {
                    S.set(root.custom-key, t);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            seg := Segmented {
                items: [Tr.t("ColorAccent"), Tr.t("ColorNeutral"), Tr.t("ColorCustom")];
                selected: root.model-index;
                changed(i) => {
                    S.set(root.key, root.values[i]);
                }
            }
        }
    }
}

// Seçenek + "Seç…" düğmesi + dosya adı (başlat simgesi, simge paketi).
component PickerRow inherits SettingRow {
    in property <string> key;
    in property <string> title;
    in property <string> file-text;
    in property <[string]> values;
    in property <[string]> labels;
    in property <string> pick-text;
    in property <string> pick-action;
    in property <string> pick-value;
    changed: S.is-changed(key);
    filtered-out: S.changed-only && !self.changed;
    highlighted: S.highlight != "" && S.highlight == title;
    property <int> model-index: S.index(root.key, root.values);
    changed model-index => {
        seg.selected = self.model-index;
    }
    SettingText { title: root.title; description: S.get(root.key) == root.pick-value ? root.file-text : ""; }
    HorizontalLayout {
        alignment: end;
        spacing: 8px;
        if S.get(root.key) == root.pick-value: VerticalLayout {
            alignment: center;
            KoyButton {
                text: root.pick-text;
                clicked => {
                    S.action(root.pick-action);
                }
            }
        }
        VerticalLayout {
            alignment: center;
            seg := Segmented {
                items: root.labels;
                selected: root.model-index;
                changed(i) => {
                    if (root.values[i] == root.pick-value && root.file-text == "") {
                        S.action(root.pick-action);
                    } else {
                        S.set(root.key, root.values[i]);
                    }
                }
            }
        }
    }
}

