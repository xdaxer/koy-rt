    spacing: 6px;
    SectionHeader { text: Tr.t("StartupHeader"); }
    BoolRow { key: "Ui.RunAtStartup"; title: Tr.t("RunAtStartupTitle"); description: ""; }
    BoolRow { key: "Dock.HideWindowsTaskbar"; title: Tr.t("HideWindowsTaskbarTitle"); description: Tr.t("HideWindowsTaskbarDesc"); }
    SectionHeader { text: Tr.t("LanguageHeader"); }
    ComboRow { key: "General.Language"; title: Tr.t("InterfaceLanguageTitle"); description: ""; values: ["tr", "en"]; labels: ["Türkçe (TR)", "English (EN)"]; }
    SectionHeader { text: Tr.t("UpdatesHeader"); }
    BoolRow { key: "General.AutoCheckUpdates"; title: Tr.t("AutoCheckUpdatesTitle"); description: ""; }
    SegRow { key: "General.UpdateChannel"; title: Tr.t("ChannelTitle"); description: ""; values: ["Stable", "Preview"]; labels: [Tr.t("ChannelStable"), Tr.t("ChannelPreview")]; }
    ButtonRow { title: Tr.t("LastCheckTitle"); description: S.text("LastCheckText"); buttons: [{ text: S.text("CheckButtonText"), action: "CheckUpdatesCommand", primary: false, danger: false, enabled: true }]; }
    SectionHeader { text: Tr.t("UnitsHeader"); }
    SegRow { key: "General.TemperatureUnit"; title: Tr.t("UnitTemperatureTitle"); description: ""; values: ["Celsius", "Fahrenheit"]; labels: [Tr.t("UnitCelsius"), Tr.t("UnitFahrenheit")]; }
    SegRow { key: "General.NetworkSpeedUnit"; title: Tr.t("UnitNetworkSpeedTitle"); description: ""; values: ["Bytes", "Bits"]; labels: [Tr.t("UnitBytes"), Tr.t("UnitBits")]; }
    InfoNotice { text: Tr.t("WindowCloseNotice"); }
}

