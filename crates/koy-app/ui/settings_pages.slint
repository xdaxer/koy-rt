    SegRow { key: "Notch.LiveBackgroundSource"; title: Tr.t("LiveBgSourceTitle"); description: ""; values: ["BuiltInAmbient", "LocalFile"]; labels: [Tr.t("LiveBgSourceAmbient"), Tr.t("LiveBgSourceFile")]; enabled: S.flag("IsLiveBackgroundEnabled"); }
    if S.flag("IsLiveBackgroundAmbientSource"): ListRow { key: "Notch.LiveBackgroundPreset"; title: Tr.t("LiveBgPresetTitle"); description: ""; list: "LiveBackgroundPresetOptions"; suffix: ""; enabled: S.flag("IsLiveBackgroundEnabled"); }
    if S.flag("IsLiveBackgroundFileSource"): ButtonRow { title: Tr.t("LiveBgFileTitle"); description: S.text("LiveBackgroundFileName"); buttons: [{ text: Tr.t("LiveBgFileChoose"), action: "PickLiveBackgroundFileCommand", primary: false, danger: false, enabled: true }]; enabled: S.flag("IsLiveBackgroundEnabled"); }
