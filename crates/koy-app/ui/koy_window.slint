// Karşılığı: koy/src/App/Features/Settings/KoyWindow.xaml.
// 880 px kabuk: 40 px başlık çubuğu, 208 px kenar çubuğu (arama, yalnız değişenler, gezinme, güncelleme, çıkış),
// sağda kaydırılan sayfa alanı, sayfa başına "varsayılana döndür", alt uyarılar ve kaldırma onayı.

import { Theme } from "theme.slint";
import { Motion, TitleButton, NavItem, KoyTextBox, KoyCheckBox, KoyButton, ButtonKind, PageTitle, PageSubtitle,
    SettingTitle, SettingDesc, KoyLogo, Segmented, SectionHeader, InfoNotice } from "controls.slint";
import { Icons, KoyIcon } from "icons.slint";
import { Tr, S } from "settings_kit.slint";
import { SL, GeneralSystemPage, NotchBehaviorPage, NotchVisualsPage, NotchPanelsPage, NotchSearchPage, DockBehaviorPage,
    DockAppearancePage, DockSectionsPage, AppearanceThemePage, AppearanceScalePage, DictationPage, PerformancePage,
    AboutPage, ShortcutsPage, SC, ShortcutRowData, DisplaysPage, DP, MonitorCardData, IdentifyOverlayWindow, GeneralProfilesPage, GeneralRulesPage, PR, RU, ProfileItemData, SectionOptionData, RuleItemData, WX, CA, AD, AdvancedRowData, AdvancedPage, EX, StoreCardData, BuiltinCardData, ConfirmFactData, ExtensionsPage, ExtensionConfirmOverlay } from "settings_pages.slint";

export { Tr, S, SL, SC, ShortcutRowData, DP, MonitorCardData, IdentifyOverlayWindow, PR, RU, ProfileItemData, SectionOptionData, RuleItemData, WX, CA, AD, AdvancedRowData, EX, StoreCardData, BuiltinCardData, ConfirmFactData }

export struct ReleaseSectionData {
    title: string,
    items: [string],
}

// Güncelleme ve "Yenilikler" pencereleri (KoyWindow.xaml UpdateOverlay / WhatsNewOverlay).
export global UP {
    in property <bool> update-open;
    in property <string> update-title;
    in property <string> update-intro;
    in property <[string]> update-highlights;
    in property <bool> downloading;
    in property <float> progress;
    in property <string> download-text;
    in property <bool> whats-new-open;
    in property <string> whats-new-title;
    in property <[string]> whats-new-highlights;
    in property <[ReleaseSectionData]> whats-new-sections;
}

component Bullet inherits HorizontalLayout {
    in property <string> text;
    spacing: 8px;
    Text { text: "•"; color: Theme.accent; font-size: Theme.font-control; }
    Text { text: root.text; color: Theme.text-primary; font-size: Theme.font-control; wrap: word-wrap; horizontal-stretch: 1; }
}

export struct SearchResultData {
    title: string,
    page: string,
}

export global KoyWindowData {
    in-out property <int> page;
    in-out property <[int]> sub-tabs: [0, 0, 0, 0];
    in property <[SearchResultData]> search-results;
    in property <float> memory-pct;
    in property <int> memory-level;
    callback select-page(int);
    callback select-sub-tab(int, int);
    callback search-changed(string);
    callback open-result(int);
    callback changed-only-toggled(bool);
}

// Sayfa başlığı + alt sekme çubuğu ("yalnız değişenler" açıkken alt sekmeler gizlenir, hepsi bir arada görünür).
component PageHeader inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    in property <[string]> tabs;
    in property <int> slot: -1;
    spacing: 4px;
    padding-bottom: 8px;
    PageTitle { text: root.title; }
    PageSubtitle { text: root.subtitle; }
    if root.tabs.length > 0 && !S.changed-only: HorizontalLayout {
        alignment: start;
        padding-top: 8px;
        Segmented {
            items: root.tabs;
            selected: KoyWindowData.sub-tabs[root.slot];
            changed(i) => {
                KoyWindowData.select-sub-tab(KoyWindowData.page, i);
            }
        }
    }
}

component Placeholder inherits VerticalLayout {
    in property <string> title;
    in property <string> subtitle;
    PageHeader { title: root.title; subtitle: root.subtitle; }
    InfoNotice { text: Tr.t("WindowCloseNotice"); }
}

component SidebarButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> primary;
    callback clicked;
    height: 34px;
    border-radius: Theme.radius-control;
    background: primary ? (ta.has-hover ? Theme.accent-hover : Theme.accent) : (ta.has-hover ? Theme.danger-bg : transparent);
    border-width: primary ? 0 : 1px;
    border-color: Theme.danger-border;
    HorizontalLayout {
        padding-left: 12px;
        spacing: 10px;
        KoyIcon { data: root.icon; size: 16px; color: root.primary ? Theme.on-accent : Theme.danger-text; }
        Text {
            text: root.text;
            color: root.primary ? Theme.on-accent : Theme.danger-text;
            font-size: Theme.font-control;
            font-weight: root.primary ? 600 : 400;
            font-family: Theme.font;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

export component KoyWindow inherits Window {
    title: "Koy";
    preferred-width: 880px;
    preferred-height: 680px;
    min-width: 880px;
    min-height: 600px;
    no-frame: true;
    background: Theme.bg-window;
    default-font-family: Theme.font;

    callback minimize();
    callback hide-window();
    callback drag-title();
    // Satır vurgusu kısa süre sonra kalkar; içerik alanı başa kaydırılır.
    public function scroll-top() {
        content.viewport-y = 0;
    }

    VerticalLayout {
        // Başlık çubuğu
        Rectangle {
            height: 40px;
            background: Theme.bg-shell;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border-shell;
            }
            TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        root.drag-title();
                    }
                }
            }
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 6px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    KoyLogo { width: 16px; height: 16px; }
                }
                Text {
                    text: "Koy";
                    font-size: 13px;
                    font-weight: 600;
                    color: Theme.text-primary;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    alignment: center;
                    TitleButton { icon: Icons.minus; label: Tr.t("WindowMinimize"); clicked => { root.minimize(); } }
                }
                VerticalLayout {
                    alignment: center;
                    TitleButton { icon: Icons.x; label: Tr.t("WindowHide"); clicked => { root.hide-window(); } }
                }
            }
        }

        HorizontalLayout {
            // Kenar çubuğu
            Rectangle {
                width: 208px;
                background: Theme.bg-shell;
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    background: Theme.border-shell;
                }
                VerticalLayout {
                    padding-left: 10px;
                    padding-right: 11px;
                    padding-top: 12px;
                    padding-bottom: 12px;
                    spacing: 2px;
                    search := KoyTextBox {
                        placeholder: Tr.t("SettingsSearchPlaceholder");
                        edited(t) => {
                            KoyWindowData.search-changed(t);
                        }
                        accepted(t) => {
                            if (KoyWindowData.search-results.length > 0) {
                                KoyWindowData.open-result(0);
                                self.text = "";
                            }
                        }
                    }
                    HorizontalLayout {
                        padding-top: 8px;
                        padding-bottom: 8px;
                        padding-left: 2px;
                        KoyCheckBox {
                            text: Tr.t("SettingsShowChangedOnly");
                            checked: S.changed-only;
                            toggled(v) => {
                                KoyWindowData.changed-only-toggled(v);
                            }
                        }
                    }
                    if search.text != "": VerticalLayout {
                        spacing: 2px;
                        if KoyWindowData.search-results.length == 0: SettingDesc { text: Tr.t("SettingsSearchNoResult"); }
                        for r[i] in KoyWindowData.search-results: Rectangle {
                            height: 44px;
                            border-radius: Theme.radius-small;
                            background: rta.has-hover ? Theme.bg-nav-hover : transparent;
                            VerticalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;
                                Text { text: r.title; font-size: 13px; color: Theme.text-primary; overflow: elide; }
                                Text { text: r.page; font-size: Theme.font-caption; color: Theme.text-muted; }
                            }
                            rta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    KoyWindowData.open-result(i);
                                    search.text = "";
                                }
                            }
                        }
                    }
                    if search.text == "": VerticalLayout {
                        spacing: 2px;
                        NavItem { icon: Icons.settings; text: Tr.t("NavGeneral"); checked: KoyWindowData.page == 0; clicked => { KoyWindowData.select-page(0); } }
                        NavItem { icon: Icons.panel-top; text: Tr.t("NavNotch"); checked: KoyWindowData.page == 1; clicked => { KoyWindowData.select-page(1); } }
                        NavItem { icon: Icons.panel-bottom; text: Tr.t("NavDock"); checked: KoyWindowData.page == 2; clicked => { KoyWindowData.select-page(2); } }
                        NavItem { icon: Icons.monitor; text: Tr.t("NavDisplays"); checked: KoyWindowData.page == 3; clicked => { KoyWindowData.select-page(3); } }
                        NavItem { icon: Icons.palette; text: Tr.t("NavAppearance"); checked: KoyWindowData.page == 4; clicked => { KoyWindowData.select-page(4); } }
                        NavItem { icon: Icons.package; text: Tr.t("NavExtensions"); checked: KoyWindowData.page == 10; clicked => { KoyWindowData.select-page(10); } }
                        NavItem { icon: Icons.keyboard; text: Tr.t("NavShortcuts"); checked: KoyWindowData.page == 5; clicked => { KoyWindowData.select-page(5); } }
                        NavItem { icon: Icons.mic; text: Tr.t("NavDictation"); checked: KoyWindowData.page == 6; clicked => { KoyWindowData.select-page(6); } }
                        NavItem { icon: Icons.activity; text: Tr.t("NavPerformance"); checked: KoyWindowData.page == 7; clicked => { KoyWindowData.select-page(7); } }
                        NavItem { icon: Icons.info; text: Tr.t("NavAbout"); checked: KoyWindowData.page == 8; clicked => { KoyWindowData.select-page(8); } }
                        if S.flag("DeveloperMode"): NavItem { icon: Icons.settings; text: Tr.t("NavAdvanced"); checked: KoyWindowData.page == 9; clicked => { KoyWindowData.select-page(9); } }
                    }
                    Rectangle { vertical-stretch: 1; }
                    if S.flag("HasAvailableUpdate"): SidebarButton {
                        primary: true;
                        icon: Icons.download;
                        text: S.text("AvailableVersionText");
                        clicked => {
                            S.action("OpenUpdateOverlayCommand");
                        }
                    }
                    if S.flag("HasAvailableUpdate"): Rectangle { height: 8px; }
                    SidebarButton {
                        icon: Icons.power;
                        text: Tr.t("ExitKoy");
                        clicked => {
                            S.action("ExitAppCommand");
                        }
                    }
                }
            }

            // İçerik alanı
            Rectangle {
                horizontal-stretch: 1;
                content := Flickable {
                    viewport-width: self.width;
                    viewport-height: pages.preferred-height + 48px;
                    pages := VerticalLayout {
                        x: 28px;
                        y: 24px;
                        width: content.width - 52px;
                        spacing: 6px;
                        if KoyWindowData.page == 0: VerticalLayout {
                            spacing: 6px;
                            PageHeader { title: Tr.t("General"); subtitle: Tr.t("GeneralSubtitle"); slot: 0; tabs: [Tr.t("SubTabGeneralSystem"), Tr.t("SubTabGeneralProfiles"), Tr.t("SubTabGeneralRules")]; }
                            if S.changed-only || KoyWindowData.sub-tabs[0] == 0: GeneralSystemPage { }
                            if S.changed-only || KoyWindowData.sub-tabs[0] == 1: GeneralProfilesPage { }
                            if S.changed-only || KoyWindowData.sub-tabs[0] == 2: GeneralRulesPage { }
                        }
                        if KoyWindowData.page == 1: VerticalLayout {
                            spacing: 6px;
                            PageHeader { title: Tr.t("NavNotch"); subtitle: Tr.t("NotchSubtitle"); slot: 1; tabs: [Tr.t("SubTabNotchBehavior"), Tr.t("SubTabNotchVisuals"), Tr.t("SubTabNotchPanels"), Tr.t("SubTabNotchSearch")]; }
                            if S.changed-only || KoyWindowData.sub-tabs[1] == 0: NotchBehaviorPage { }
                            if S.changed-only || KoyWindowData.sub-tabs[1] == 1: NotchVisualsPage { }
                            if S.changed-only || KoyWindowData.sub-tabs[1] == 2: NotchPanelsPage { }
                            if S.changed-only || KoyWindowData.sub-tabs[1] == 3: NotchSearchPage { }
                        }
                        if KoyWindowData.page == 2: VerticalLayout {
                            spacing: 6px;
                            PageHeader { title: Tr.t("NavDock"); subtitle: Tr.t("DockSubtitle"); slot: 2; tabs: [Tr.t("SubTabDockBehavior"), Tr.t("SubTabDockAppearance"), Tr.t("SubTabDockSections")]; }
                            if S.changed-only || KoyWindowData.sub-tabs[2] == 0: DockBehaviorPage { }
                            if S.changed-only || KoyWindowData.sub-tabs[2] == 1: DockAppearancePage { }
                            if S.changed-only || KoyWindowData.sub-tabs[2] == 2: DockSectionsPage { }
                        }
                        if KoyWindowData.page == 3: VerticalLayout {
                            spacing: 6px;
                            PageHeader { title: Tr.t("NavDisplays"); subtitle: Tr.t("DisplaysSubtitle"); }
                            DisplaysPage { }
                        }
                        if KoyWindowData.page == 4: VerticalLayout {
                            spacing: 6px;
                            PageHeader { title: Tr.t("NavAppearance"); subtitle: Tr.t("AppearanceSubtitle"); slot: 3; tabs: [Tr.t("SubTabAppearanceTheme"), Tr.t("SubTabAppearanceScaleMotion")]; }
                            if S.changed-only || KoyWindowData.sub-tabs[3] == 0: AppearanceThemePage { }
                            if S.changed-only || KoyWindowData.sub-tabs[3] == 1: AppearanceScalePage { }
                        }
                        if KoyWindowData.page == 5: VerticalLayout {
                            spacing: 6px;
                            PageHeader { title: Tr.t("NavShortcuts"); subtitle: Tr.t("ShortcutsSubtitle"); }
                            ShortcutsPage { }
                        }
                        if KoyWindowData.page == 6: VerticalLayout {
                            spacing: 6px;
                            PageHeader { title: Tr.t("NavDictation"); subtitle: Tr.t("DictationSubtitle"); }
                            DictationPage { }
                        }
                        if KoyWindowData.page == 7: VerticalLayout {
                            spacing: 6px;
                            PageHeader { title: Tr.t("NavPerformance"); subtitle: Tr.t("PerformanceSubtitle"); }
                            PerformancePage { memory-pct: KoyWindowData.memory-pct; memory-level: KoyWindowData.memory-level; }
                        }
                        if KoyWindowData.page == 8: VerticalLayout {
                            spacing: 6px;
                            PageHeader { title: Tr.t("NavAbout"); subtitle: Tr.t("AboutSubtitle"); }
                            AboutPage { }
                        }
                        if KoyWindowData.page == 9: VerticalLayout {
                            spacing: 6px;
                            PageHeader { title: Tr.t("NavAdvanced"); subtitle: Tr.t("AdvancedSubtitle"); }
                            AdvancedPage { }
                        }
                        if KoyWindowData.page == 10: VerticalLayout {
                            spacing: 6px;
                            PageHeader { title: Tr.t("NavExtensions"); subtitle: Tr.t("ExtensionsSubtitle"); }
                            ExtensionsPage { }
                        }
                    }
                }

                // Sayfa başına "Varsayılana döndür": başlığın sağında, iki adımlı onay. Dock ve Ekranlar'da yok.
                if S.flag("CanResetPage"): HorizontalLayout {
                    x: parent.width - self.preferred-width - 40px;
                    y: 24px;
                    height: 28px;
                    spacing: 8px;
                    if S.flag("PageResetDone"): SettingDesc { text: Tr.t("SettingsResetPageDone"); vertical-alignment: center; }
                    if !S.flag("IsPageResetConfirming"): KoyButton { text: Tr.t("SettingsResetPage"); clicked => { S.action("RequestPageResetCommand"); } }
                    if S.flag("IsPageResetConfirming"): SettingDesc { text: Tr.t("SettingsResetPageConfirm"); vertical-alignment: center; }
                    if S.flag("IsPageResetConfirming"): KoyButton { text: Tr.t("Cancel"); clicked => { S.action("CancelPageResetCommand"); } }
                    if S.flag("IsPageResetConfirming"): KoyButton { text: Tr.t("ResetConfirmButton"); kind: ButtonKind.danger; clicked => { S.action("ConfirmPageResetCommand"); } }
                }

                // Alt uyarılar: riskli ayar için uygula/geri al geri sayımı ve okunamayan settings.json bildirimi.
                VerticalLayout {
                    y: parent.height - self.preferred-height - 16px;
                    x: (parent.width - self.preferred-width) / 2;
                    spacing: 8px;
                    if S.flag("IsApplyRevertPending"): Rectangle {
                        background: Theme.bg-row;
                        border-width: 1px;
                        border-color: Theme.accent;
                        border-radius: Theme.radius-row;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 8px;
                            Text {
                                text: Tr.t("ApplyRevertPrompt") + " " + S.text("ApplyRevertSecondsLeft");
                                color: Theme.text-primary;
                                vertical-alignment: center;
                            }
                            KoyButton { text: Tr.t("ApplyRevertRevert"); clicked => { S.action("RevertApplyRevertCommand"); } }
                            KoyButton { text: Tr.t("ApplyRevertKeep"); kind: ButtonKind.primary; clicked => { S.action("ConfirmApplyRevertCommand"); } }
                        }
                    }
                    if S.flag("SettingsFileInvalid"): Rectangle {
                        background: Theme.danger-bg;
                        border-width: 1px;
                        border-color: Theme.danger-border;
                        border-radius: Theme.radius-row;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            Text { text: Tr.t("SettingsFileInvalid"); color: Theme.danger-text; wrap: word-wrap; max-width: 520px; }
                        }
                    }
                }
            }
        }
    }

    if EX.confirming: ExtensionConfirmOverlay { }

    if UP.update-open: Rectangle {
        background: Theme.scrim;
        TouchArea { }
        Rectangle {
            width: 480px;
            height: ucard.preferred-height;
            background: Theme.bg-row;
            border-width: 1px;
            border-color: Theme.border-strong;
            border-radius: Theme.radius-row;
            ucard := VerticalLayout {
                padding: 22px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    KoyIcon { data: Icons.download; size: 20px; color: Theme.accent; }
                    Text { text: UP.update-title; font-size: Theme.font-page-title; font-weight: 600; color: Theme.text-primary; }
                }
                SettingDesc { text: UP.update-intro; }
                for h in UP.update-highlights: Bullet { text: h; }
                if UP.downloading: VerticalLayout {
                    spacing: 6px;
                    Rectangle {
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.toggle-track-off;
                        Rectangle { x: 0; width: parent.width * clamp(UP.progress, 0, 1); border-radius: 3px; background: Theme.accent; }
                    }
                    SettingDesc { text: UP.download-text; }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    KoyButton { text: Tr.t("UpdateLater"); enabled: !UP.downloading; clicked => { S.action("CloseUpdateOverlayCommand"); } }
                    KoyButton { text: Tr.t("UpdateNow"); kind: ButtonKind.primary; enabled: !UP.downloading; clicked => { S.action("StartUpdateCommand"); } }
                }
            }
        }
    }

    if UP.whats-new-open: Rectangle {
        background: Theme.scrim;
        TouchArea { }
        Rectangle {
            width: 520px;
            height: min(root.height - 80px, wcard.preferred-height);
            background: Theme.bg-row;
            border-width: 1px;
            border-color: Theme.border-strong;
            border-radius: Theme.radius-row;
            clip: true;
            Flickable {
                viewport-height: wcard.preferred-height;
                wcard := VerticalLayout {
                    padding: 22px;
                    spacing: 8px;
                    Text { text: UP.whats-new-title; font-size: Theme.font-page-title; font-weight: 600; color: Theme.text-primary; }
                    for h in UP.whats-new-highlights: Bullet { text: h; }
                    for sec in UP.whats-new-sections: VerticalLayout {
                        spacing: 4px;
                        padding-top: 6px;
                        SectionHeader { text: sec.title; }
                        for it in sec.items: Bullet { text: it; }
                    }
                    HorizontalLayout {
                        alignment: end;
                        padding-top: 8px;
                        KoyButton { text: Tr.t("WhatsNewDone"); kind: ButtonKind.primary; clicked => { S.action("CloseWhatsNewOverlayCommand"); } }
                    }
                }
            }
        }
    }

    // Kaldırma onayı
    if S.flag("IsUninstallConfirming"): Rectangle {
        background: Theme.scrim;
        TouchArea { }
        Rectangle {
            width: 440px;
            height: card.preferred-height;
            background: Theme.bg-row;
            border-width: 1px;
            border-color: Theme.border-strong;
            border-radius: Theme.radius-row;
            card := VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text { text: Tr.t("UninstallDialogTitle"); font-size: Theme.font-page-title; font-weight: 600; color: Theme.text-primary; }
                SettingDesc { text: Tr.t("UninstallDialogIntro"); }
                SettingTitle { text: "• " + Tr.t("UninstallItemApp"); }
                SettingTitle { text: "• " + Tr.t("UninstallItemTaskbar"); }
                KoyCheckBox {
                    text: Tr.t("UninstallKeepSettings");
                    checked: S.flag("KeepSettingsOnUninstall");
                    toggled(v) => {
                        S.action("ToggleKeepSettingsOnUninstall");
                    }
                }
                SettingDesc { text: Tr.t("UninstallKeepSettingsDesc"); }
                if !S.flag("KeepSettingsOnUninstall"): Text { text: Tr.t("UninstallDeleteWarn"); color: Theme.danger-text; wrap: word-wrap; font-size: Theme.font-caption; }
                if S.text("UninstallError") != "": Text { text: S.text("UninstallError"); color: Theme.danger-text; wrap: word-wrap; font-size: Theme.font-caption; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    KoyButton { text: Tr.t("Cancel"); clicked => { S.action("CancelUninstallCommand"); } }
                    KoyButton { text: Tr.t("UninstallConfirm"); kind: ButtonKind.danger; clicked => { S.action("ConfirmUninstallCommand"); } }
                }
            }
        }
    }
}
